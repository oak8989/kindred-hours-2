# Docker host binding. Defaults to localhost only; change BIND_ADDRESS to 0.0.0.0 for LAN access.
# Check the port is free BEFORE starting Compose; the wizard cannot remap a running container.
HOST_PORT=3000
BIND_ADDRESS=127.0.0.1

# Set to 1 only when traffic comes through a trusted HTTPS reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=0

# Organization, SMTP and first admin credentials are configured through the application, not this file.
